# Plantilla de variables de entorno. Copiar a .env y rellenar con valores reales:
#   cp .env.example .env
# .env esta gitignored.

# --- MLflow Registry ---
# Nota: en este servidor la API REST se publica bajo /ajax-api/2.0, no /api/2.0
MLFLOW_TRACKING_URI=https://iacom.uv.es/sira-mlflow
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# --- Modelo a servir ---
# Nombre registrado: sira-yolo11n-{SIRA_SPECIALTY}
SIRA_SPECIALTY=General
SIRA_MODEL_ALIAS=champion

# --- Servidor ---
# Solo loopback: se accede desde el Mac por tunel ssh
#   ssh -L 8080:localhost:8080 deploy@192.168.1.36
# Poner 192.168.1.36 para exponerlo en la LAN (sin autenticacion).
SIRA_SERVE_HOST=127.0.0.1
SIRA_SERVE_PORT=8080
